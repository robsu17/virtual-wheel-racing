    <!-- Guia por jogo -->
    <string name="guide_subtitle">Só na primeira vez em cada jogo</string>
    <string name="guide_ets2_1">Em Opções &gt; Controles, escolha o tipo \"Volante e pedais\" ou \"Teclado + Joystick\".</string>
    <string name="guide_ets2_2">Selecione o vJoy Device como controle.</string>
    <string name="guide_ets2_3">Em Direção, Acelerador e Freio, clique no campo e use o modo configuração abaixo.</string>
    <string name="guide_ets2_tip">Vale o mesmo para o American Truck Simulator.</string>
    <string name="guide_assetto_1">No Content Manager ou em Opções &gt; Controles, escolha \"Volante\".</string>
    <string name="guide_assetto_2">Selecione o vJoy Device.</string>
    <string name="guide_assetto_3">Clique em Direção, Acelerador e Freio e use o modo configuração abaixo.</string>
    <string name="guide_beamng_1">Em Opções &gt; Controles, encontre o vJoy Device na lista.</string>
    <string name="guide_beamng_2">Associe Direção, Acelerador e Freio usando o modo configuração abaixo.</string>
    <string name="guide_beamng_3">Em Filtros de direção, escolha \"Direto\" para sentir como um volante.</string>
    <string name="guide_rfactor_1">Em Controles, escolha vJoy Device como controlador.</string>
    <string name="guide_rfactor_2">Clique em Direção, Acelerador e Freio e use o modo configuração abaixo.</string>
    <string name="guide_rfactor_3">Não é preciso inverter nenhum eixo.</string>
    <string name="guide_rfactor_tip">Testado e aprovado no rFactor 1.</string>
    <string name="guide_other_1">Procure a tela de Controles do jogo e escolha vJoy Device.</string>
    <string name="guide_other_2">Para cada comando (Direção, Acelerador, Freio), clique no campo e use o modo configuração abaixo.</string>
    <string name="guide_other_3">Se um pedal ficar ao contrário, use a opção de inverter eixo do jogo.</string>
    <string name="guide_other_tip">Jogos que só aceitam controle de Xbox podem não reconhecer.</string>
