    <!-- Welcome -->
    <string name="welcome_title_start">"Your phone becomes\na "</string>
    <string name="welcome_title_highlight">steering wheel</string>
    <string name="welcome_subtitle">Play Euro Truck, Assetto Corsa and other PC racing games by turning your phone.</string>
    <string name="welcome_step1_title">Install the program on your PC</string>
    <string name="welcome_step1_subtitle">It\'s free and takes a minute</string>
