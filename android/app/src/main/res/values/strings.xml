    <!-- Pairing (change PC) -->
    <string name="pairing_title">Connect to a PC</string>
    <string name="pairing_body">Open Virtual Wheel Racing on Windows and point the camera at the QR code on the screen.</string>
    <string name="pairing_frame_description">Frame for the QR code</string>
    <string name="pairing_frame_hint">Tap Scan the PC code</string>
    <string name="pairing_note">Phone and PC must be on the same Wi-Fi network, ideally 5 GHz. The phone remembers the PC; you only need to scan again if you switch PCs or create a new code.</string>

