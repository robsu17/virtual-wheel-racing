    <!-- Game guide -->
    <string name="guide_subtitle">Only the first time in each game</string>
    <string name="guide_ets2_1">In Options &gt; Controls, choose the \"Steering wheel and pedals\" or \"Keyboard + Joystick\" type.</string>
    <string name="guide_ets2_2">Select vJoy Device as the controller.</string>
    <string name="guide_ets2_3">For Steering, Throttle and Brake, click the field and use setup mode below.</string>
    <string name="guide_ets2_tip">The same goes for American Truck Simulator.</string>
    <string name="guide_assetto_1">In Content Manager or Options &gt; Controls, choose \"Wheel\".</string>
    <string name="guide_assetto_2">Select vJoy Device.</string>
    <string name="guide_assetto_3">Click Steering, Throttle and Brake and use setup mode below.</string>
    <string name="guide_beamng_1">In Options &gt; Controls, find vJoy Device in the list.</string>
    <string name="guide_beamng_2">Bind Steering, Throttle and Brake using setup mode below.</string>
    <string name="guide_beamng_3">Under Steering filters, choose \"Direct\" for a wheel-like feel.</string>
    <string name="guide_rfactor_1">In Controls, choose vJoy Device as the controller.</string>
    <string name="guide_rfactor_2">Click Steering, Throttle and Brake and use setup mode below.</string>
    <string name="guide_rfactor_3">No axis needs to be inverted.</string>
    <string name="guide_rfactor_tip">Tested and approved in rFactor 1.</string>
    <string name="guide_other_1">Find the game\'s Controls screen and choose vJoy Device.</string>
    <string name="guide_other_2">For each control (Steering, Throttle, Brake), click the field and use setup mode below.</string>
    <string name="guide_other_3">If a pedal works backwards, use the game\'s invert axis option.</string>
    <string name="guide_other_tip">Games that only accept Xbox controllers may not detect it.</string>
    <string name="setup_mode">Setup mode</string>
    <string name="setup_mode_body">When the game asks for a control, tap it on the phone (Steering, Throttle or Brake) and move only that. This way the game won\'t mix them up.</string>
    <string name="open_setup_mode">Open setup mode</string>
    <string name="every_game">In every game</string>
    <string name="every_game_deadzone">Set the game\'s deadzone to 0%: the app already handles it.</string>
    <string name="every_game_ffb">Turn off force feedback: the phone can\'t push back.</string>

